{
  "name": "@paranod/plugin-sdk",
  "version": "0.2.0",
  "description": "Official SDK for building external plugins for PARANOD",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "paranod",
    "osint",
    "plugin",
    "sdk",
    "external-plugin"
  ],
  "author": "PARANOD Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paranod/plugin-sdk.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "express": "^4.22.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "qs": "6.16.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
