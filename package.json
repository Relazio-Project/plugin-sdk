{
  "name": "@relazio/plugin-sdk",
  "version": "0.1.1",
  "description": "Official SDK for building external plugins for Relazio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "relazio",
    "osint",
    "plugin",
    "sdk",
    "external-plugin"
  ],
  "author": "Relazio Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relazio/plugin-sdk.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
